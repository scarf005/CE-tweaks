<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RIMWORLD_DIR Condition="'$(RIMWORLD_DIR)' == ''">/media/scarf/@steam/SteamLibrary/steamapps/common/RimWorld</RIMWORLD_DIR>
    <RIMWORLD_WORKSHOP_DIR Condition="'$(RIMWORLD_WORKSHOP_DIR)' == ''">$(RIMWORLD_DIR)/../../workshop/content/294100</RIMWORLD_WORKSHOP_DIR>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>CETweaks</AssemblyName>
    <RootNamespace>CEOverPressure</RootNamespace>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../1.7/Assemblies/</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PressureModel.fs" />
    <Compile Include="Utils.fs" />
    <Compile Include="Defs.fs" />
    <Compile Include="ModSettings.fs" />
    <Compile Include="IdleReloadPriority.fs" />
    <Compile Include="IdleReload.fs" />
    <Compile Include="DamageWorkers.fs" />
    <Compile Include="Overpressure.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.401" ExcludeAssets="runtime" />
    <Reference Include="$(RIMWORLD_DIR)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(RIMWORLD_DIR)/UnityStubs.dll" Private="false" />
    <Reference Include="$(RIMWORLD_WORKSHOP_DIR)/2009463077/1.7/Assemblies/0Harmony.dll" Private="false" />
    <Reference Include="$(COMBAT_EXTENDED_DIR)/Assemblies/CombatExtended.dll" Private="false" />
  </ItemGroup>
</Project>
